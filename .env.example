# Copy to .env — never commit the real file.

# Where the SQLite database and the project folders live.
DATA_DIR=/data
DB_PATH=/data/luma.db

# Secrets (generate with: openssl rand -base64 32)
MASTER_KEY=
SESSION_SECRET=

# Origins. The preview origin MUST differ from the app origin so project JS can't touch app cookies.
# Production: APP_ORIGIN=https://studio.example.com  PREVIEW_ORIGIN=https://preview.example.com (both routed to the one container port).
# Local development with `pnpm dev`: the SPA runs on :5180 and proxies /api, so APP_ORIGIN must be http://localhost:5180.
APP_ORIGIN=http://localhost:8080
PREVIEW_ORIGIN=http://localhost:8081

PORT=8080

# Heavy jobs (renders, preview frames) start only while total CPU usage is below this fraction.
CPU_BUDGET=0.9
# Max parallel render workers (default: cores - 1).
MAX_RENDER_WORKERS=
# a render is killed after this many minutes
RENDER_TIMEOUT_MIN=90
# Default timeout for agent bash commands, seconds.
CMD_TIMEOUT_S=120

LOG_LEVEL=info

# ---- hosting (see docs/deploy.md) ----
# Hostnames Caddy serves (docker-compose.yml). APP_ORIGIN / PREVIEW_ORIGIN above must be https://<these>.
APP_HOST=studio.example.com
PREVIEW_HOST=preview.example.com
CPUS=3.5
MEM_LIMIT=12g

# ---- limits ----
# Storage per student (all projects, uploads and renders), MB. 0 = unlimited.
USER_QUOTA_MB=5120
# FREE render time on this server per student per rolling 24 h, minutes (default 5 h). 0 = unlimited.
RENDER_MINUTES_PER_DAY=300
# FAST render hours (paid, render on the remote workers; docs/payments.md): price per hour and max hours per order
RENDER_HOUR_PRICE_BDT=100
RENDER_HOURS_MAX_PER_ORDER=20
# One-time add-ons (Settings → Add-ons): Luma Studio API access and the source code (BDT); source-code buyers
# are shown this WhatsApp number to get the code
ADDON_API_PRICE_BDT=500
ADDON_SOURCE_PRICE_BDT=2000
SOURCE_CODE_WHATSAPP=+8801744136934
# PayStation payment gateway. Unset = students can't buy (admin boost-grant still works).
# Sandbox test merchant: 104-1653730183 / gamecoderstorepass. Give PayStation the IPN URL
# https://<APP_ORIGIN host>/api/billing/paystation/ipn
PAYSTATION_ENV=sandbox
PAYSTATION_MERCHANT_ID=
PAYSTATION_PASSWORD=
# Remote render workers: a claimed job goes back to the queue after this long without a progress report;
# a worker counts as online if it called in within WORKER_ONLINE_S
WORKER_LEASE_S=120
WORKER_ONLINE_S=90
# Deleted projects are removed from disk after this many days.
PURGE_AFTER_DAYS=7
# Requests per minute and IP on the preview origin.
PREVIEW_RATE_PER_MIN=1500

# ---- backups (SQLite online backup, nightly) ----
BACKUP_KEEP=7
BACKUP_HOUR=3

# ---- abuse controls (optional) ----
# Admin panel (/admin): comma-separated e-mails of Studio accounts that may open it
ADMIN_EMAILS=
# Accounts come from lumademy.com: its backend calls POST /api/provision/users with this key (docs/provisioning.md).
# Generate one with: openssl rand -hex 32 — unset = provisioning API off.
PROVISION_API_KEY=
# Public sign-up on the Studio is off by default (SIGNUP_ENABLED=1 opens it again).
# SIGNUP_ENABLED=0 closes signup. Fill both to require an hCaptcha on signup.
HCAPTCHA_SITEKEY=
HCAPTCHA_SECRET=

# ---- observability (optional) ----
# Bearer token that unlocks GET /api/metrics (Prometheus text). Unset = no such endpoint.
METRICS_TOKEN=
# Sentry or GlitchTip DSN for unhandled errors.
ERROR_TRACKING_DSN=

# Agent runs a student can have going at once (each project runs one; students bring their own model keys)
MAX_RUNS_PER_USER=4

# Shared agent lessons (save_lesson): auto = used at once by every run, review = approve with `admin lesson-approve`, off
AGENT_LESSONS=auto
# Shared asset library (share_asset/use_asset; files in DATA_DIR/library): 1 = on, 0 = off
SHARED_LIBRARY=1
