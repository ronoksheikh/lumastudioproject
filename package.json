{
  "name": "luma-studio",
  "private": true,
  "version": "0.1.0",
  "description": "Luma Studio — Lumademy's AI motion-graphics studio",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @luma/api --filter @luma/web dev",
    "build": "pnpm --filter @luma/web build && pnpm --filter @luma/api build",
    "start": "pnpm --filter @luma/api start",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "db:generate": "pnpm --filter @luma/api db:generate",
    "evals:test": "node --test evals/score.test.mjs",
    "evals": "node evals/run.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
